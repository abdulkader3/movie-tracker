# Copy this file to ".env" and fill in your keys.

# Required. Free key: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
VITE_TMDB_API_READ_ACCESS_TOKEN=

# Optional. Used only to enrich entries with IMDb ratings.
# Free key: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=

# Backup & Recovery (Cloudflare Worker URL and auth token)
# Deploy the worker in worker/ first, then set these.
VITE_BACKUP_SERVICE_URL=
VITE_BACKUP_AUTH_TOKEN=
