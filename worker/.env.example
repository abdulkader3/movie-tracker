# Copy this file to ".dev.vars" for local development with `wrangler dev`.
# Do NOT commit ".dev.vars" to Git.

# Pre-shared authentication token. The desktop app must include this
# in the Authorization: Bearer <token> header for every request.
BACKUP_AUTH_TOKEN=

# R2 bucket binding is configured in wrangler.toml.
# R2 credentials are managed by Cloudflare when deployed.
